{
  "expo": {
    "name": "CuidarPlus - Transit SP",
    "slug": "cuidarplus-transit-sp",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "plugins": [
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Permitir que o CuidarPlus encontre pontos de ônibus próximos."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#0288d1"
        }
      ]
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "br.com.fiap.cuidarplus"
    },
    "android": {
      "package": "br.com.fiap.cuidarplus",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    }
  }
}
